        "omitted": "omitted: claude (no per-call timing) · codex cannot separate model-error retries",
        "html": "html: %s",
        "trim_scan": "scan cut: %d files not looked at (limit %d files · oldest first)",
        "trim_name": "name lookup cut: %d candidates unnamed (read budget %s, name share %s)",
        "trim_sample": "sample cut: %d sessions left out (limit %d sessions)",
        "trim_mb": "sample cut: %d sessions left out (read budget %s)",
        "trim_grow": "read cut: %d sessions stopped at the reserved size (the log grew while reading)",
        "no_session": "no session in window — try a larger --hours",
        "split_out": "cannot compare: split is outside the window",
