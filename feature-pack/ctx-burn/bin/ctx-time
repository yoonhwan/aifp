#!/usr/bin/env python3
"""ctx-time — where did the seats spend their time? (read-only)

Reads local session logs (pi · codex) and reports per-category working time, the
commands that ran over the limit (70s by default) and where the wall clock went.
Writes at most one html file under --out (two when --split is used).

Safety — two separate promises:
  (1) body keys are never queried: only timestamp · durationMs · type · role ·
      session_info.name · toolCall name/id · arguments.command (or path, head 400) ·
      arguments.timeout · errorMessage (head 60).
  (2) nothing is exported but numbers, timestamps, fixed words from this file,
      seat names and session file paths. Command lines and error messages are read
      to pick a category and never printed — not even the first word.

Reading budget is staged (§3): list names (no read) → stat up to --max-scan →
name lookup inside 1/5 of --max-mb → read bodies until --max-mb is spent.
Every cut is printed; nothing is silently dropped.
"""
import argparse
import glob
import html
import json
import os
import re
import sys
import time
from datetime import datetime

NAME_PROBE = 64 * 1024
PI_ROOT = "~/.pi/agent/sessions"
CODEX_ROOT = "~/.codex/sessions"
DEFAULT_OUT = "~/.cache/ctx-burn/time"

CATS = [
    ("sleep 대기", re.compile(r"(^|[;&|]\s*|\bdo\s+|\bthen\s+)sleep\s+\d")),
    ("시험", re.compile(r"pytest|tests?/test_|test_[A-Za-z0-9_]+\.(sh|py)|runb\.sh|solo\.sh|chunk\.sh")),
    ("쪽지(mbox)", re.compile(r"mbox\.sh")),
    ("승인·착지·설치 도구", re.compile(r"ft-autonomy|ft-merge|ft-hil|ft-nano-(close|record)|ft-successor|ft-seat-retire|ft-index-lint|gen-h-|/tmp/h\d+")),
    ("git", re.compile(r"\bgit\b|\bgh\b")),
    ("코드 찾기(ci·grep·find)", re.compile(r"\bci\b|\bgrep\b|\brg\b|\bfind\b")),
]
CAT_READ = "파일 읽기·쓰기"
CAT_BASH = "그 밖 bash"

KINDS = [
    ("pytest", re.compile(r"\bpytest\b")),
    ("셸 시험(test_*.sh)", re.compile(r"test_[A-Za-z0-9_]+\.sh")),
    ("sleep", re.compile(r"(^|[;&|(]\s*|\bdo\s+|\bthen\s+)sleep\s+\d")),
    ("grep -r(되풀이 검색)", re.compile(r"\bgrep\s+(-[A-Za-z]*[rR][A-Za-z]*|--recursive)")),
    ("grep(그 밖)", re.compile(r"\bgrep\b")),
    ("find", re.compile(r"(^|[;&|(]\s*)find\s")),
    ("rg", re.compile(r"\brg\s")),
    ("ci", re.compile(r"(^|[;&|(]\s*)ci\s")),
    ("git", re.compile(r"\bgit\s")),
    ("timeout 을 붙인 명령", re.compile(r"\b(g?timeout)\s+(-k\s+\S+\s+)?\d")),
]

COL = {"LLM 생성": "#4c78a8", "모델 오류 재시도": "#000000", "sleep 대기": "#d62728", "시험": "#f58518",
       "쪽지(mbox)": "#72b7b2", "승인·착지·설치 도구": "#b279a2", "git": "#9d755d",
       "코드 찾기(ci·grep·find)": "#54a24b", CAT_READ: "#bab0ac", CAT_BASH: "#eeca3b",
       "유휴(다음 입력 대기)": "#dddddd", "그 밖(사이 시간)": "#f2f2f2"}
ORDER = list(COL)
IDLE = "유휴(다음 입력 대기)"
OTHER = "그 밖(사이 시간)"
ROLES = ["desk", "master", "arch", "da", "nano", "그 밖"]
ROLE_RX = re.compile(r"-(master|arch|nano|desk|da)(?=[-#]|$)")

STR = {
    "en": {
        "head": "ctx-time — last %s · sessions %d (pi %d · codex %d) · worked %s · %s",
        "row": " %d %-16s %9s %3.0f%%  %s  %d calls · avg %s · over %s: %d",
