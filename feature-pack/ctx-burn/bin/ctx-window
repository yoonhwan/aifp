#!/usr/bin/env python3
"""ctx-window — where did the conversation window go? (read-only)

Reads local pi session logs and reports the four places a seat wastes its
conversation window:

  W1  bell turns      — share of weighted cost spent on turns that only took a ring
                        (W1a = every ring turn, W1b = ring turns whose every tool call
                        was one pure `mbox.sh recv` line)
  W2  boot turns      — window used to boot (from turn 1 to the turn the boot report
                        call landed), plus the tool calls spent there
  W3  past the gate   — tokens still spent after the window first crossed --recv-gate
  W4  tool results    — result count, bytes, results over --result-cap, the
                        cut notices (W4c) and how often the full text was re-read

Safety — two separate promises:
  (1) body keys are never queried: only timestamp · type · role · message.usage
      counters · message.content[].type · toolCall name/id/arguments.command (head
      400) · session_info.name (head 64KB probe). Model text, thinking and tool
      result text are never parsed for meaning.
  (2) nothing is exported but numbers, timestamps, fixed words from this file,
      seat names and session file paths. No command line, no result text, no
      conversation text — not even the first word.

The four numbers mirror the harness originals (analyze2.py · cap.py) so a value
measured here can be compared with the values those cards landed.

Reading: the sample is chosen by the landed ctx-time body — `Budget` · `list_files`
· `scan_window` · `pick` · `read_lines` (importlib, bytecode writing off). The only
place a session file is opened is `read_lines(path, reserved)`; every cut is printed.
"""
import argparse
import html
import importlib.machinery
import importlib.util
import json
import os
import re
import sys
import time
from datetime import datetime

sys.dont_write_bytecode = True

DEFAULT_OUT = "~/.cache/ctx-burn/window"
NAME_PROBE = 64 * 1024
CMD_HEAD = 400          # 명령 줄은 머리 400자만 본다(ctx-time 과 같다)
BOOT_TAIL = 20          # 부팅 보고가 없는 좌석 = 0부터 20번째 턴이 이미 쌓인 뒤부터 «부팅 뒤»

BOOT_MARK = "[부팅 보고]"
BELL_MARK = "[발주 #"
REREAD_MARK = "ft-tool-result/"

# W4c — pi 절단 통지 꼴. 줄 머리부터 맞음 · `· <숫자>줄` 은 있어도 없어도 된다(새 꼴·옛 꼴).
NOTICE_PREFIX = "[결과 상한]".encode("utf-8")
NOTICE_RX = re.compile(
    (r"\[결과 상한\] 전문 ([0-9]+)바이트(?: · [0-9]+줄)? 중 머리 ([0-9]+) · 꼬리 ([0-9]+) 만 실음 · 전문 = ").encode("utf-8")
)                                                                  # 바이트 판으로 견준다(다시 인코딩 0)


def load_time_body():
    """같은 폴더의 ctx-time 을 모듈로 싣는다(확장자가 없어 그냥 import 가 안 된다)."""
    here = os.path.dirname(os.path.abspath(__file__))
    loader = importlib.machinery.SourceFileLoader("ctx_window_time", os.path.join(here, "ctx-time"))
    spec = importlib.util.spec_from_loader("ctx_window_time", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


TIME = load_time_body()          # E8 — 표본 고르기·읽기는 이 본체의 함수를 그대로 부른다

# ---------------------------------------------------------------- pure recv (W1c)
# 낱말 = 작은따옴표 글 · `$`·백틱이 없는 큰따옴표 글 · 허용 글자만으로 된 토막
WORD = r"""(?:'[^']*'|"[^"$`\\]*"|[A-Za-z0-9_@%+=:,./#~-]+)"""
RECV_RX = re.compile(
    r"^(?:cd +" + WORD + r" +&& +)?"                      # 맨 앞 cd 1번만 && 를 받는다
    r"(?:[A-Za-z_][A-Za-z0-9_]*=" + WORD + r" +)*"        # 이름=낱말 여러 개
    r"(?:bash +)?"                                        # bash 는 있어도 없어도 된다
    r"[A-Za-z0-9_@%+=:,./#~-]*mbox\.sh +recv"             # <경로>mbox.sh recv
    r"(?: +" + WORD + r"){0,3}"                           # 좌석 이름 · 인자 0 ~ 3개
    r"(?: +2>&1)?"                                        # stderr 합치기
    r"(?: +\| +(?:tail|head)(?: +-n +[0-9]+| +-[0-9]+))?"  # 출력 줄이기 1개(tail/head)
    r"\Z"
)


def pure_recv(name, cmd):
    """W1c — 명령 줄 «전체» 가 한 꼴과 끝까지 맞을 때만 참(부분 일치 0)."""
    if (name or "").lower() != "bash":
        return False
    if len(cmd) > CMD_HEAD:      # 400자에서 잘린 명령은 끝까지 맞음을 확인할 수 없다
        return False
    return RECV_RX.match(cmd) is not None


# ---------------------------------------------------------------- cells
# ---------------------------------------------------------------- cells
def res_text(c):
    """도구 결과 글 — 크기를 재려고 이어 붙이기만 한다(analyze2.text_of 와 같은 꼴).

    이 함수의 값은 바이트 수와 W4c 절단 통지 판별로만 쓰이고 어디에도 실리지 않는다.
    """
    if isinstance(c, str):
        return c
    out = []
    for x in c or []:
        t = x.get("type") if isinstance(x, dict) else None
        if t == "text":
            out.append(x.get("text", ""))
        elif t == "thinking":
            out.append(x.get("thinking", ""))
        elif t == "toolCall":
            out.append(json.dumps(x.get("arguments", {}), ensure_ascii=False))
    return "\n".join(out)


def ctx_of(u):
    """대화창 크기 = 입력 + 캐시 읽기 + 캐시 쓰기 (analyze2 와 같다)."""
    return int(u.get("input") or 0) + int(u.get("cacheRead") or 0) + int(u.get("cacheWrite") or 0)


def cost_of(u):
    """가중 비용 = 읽기 0.1 · 쓰기 1.25 · 입력 1.0 (analyze2 와 같다)."""
    return 0.1 * int(u.get("cacheRead") or 0) + 1.25 * int(u.get("cacheWrite") or 0) + int(u.get("input") or 0)


def k(n):
    if n is None:
        return "-"
    return ("%dk" % round(n / 1000.0)) if n >= 1000 else str(int(n))


def by(n):
    return "%sB" % format(int(n), ",")


def pct(x):
    return "%5.1f%%" % (100.0 * x)


def med(vals):
    if not vals:
        return 0
    v = sorted(vals)
    return v[len(v) // 2]


# ---------------------------------------------------------------- reading one session
def parse_window_lines(lines, w_from, w_to):
    """세션 몸 → 턴(숫자와 호출 꼴만) · 도구 결과(바이트 수와 W4c 판별) · 표식 유무.

    창 자르기는 ctx-time 의 parse 와 같은 규칙이다: timestamp 가 없거나
    `t < w_from` 이거나 `t >= w_to` 인 줄은 세지 않는다(양끝 = from 포함 · to 제외).

    원본 analyze2 와 같은 차례를 지킨다: 턴을 쌓을 때의 «부팅 뒤» 상태는 그 턴의
    도구 호출을 보기 «전» 값이다. 그래서 `[부팅 보고]` 를 부른 턴은 아직 부팅 안이며,
    부팅 끝 = 처음 부팅 뒤가 된 턴(0부터 세어 20 이면 21번째 턴).
    """
    turns, results = [], []
    marks = {"bell": False, "boot": False, "cap": False, "reread": False}
    bell, booted = False, False
    for line in lines:
        try:
            d = json.loads(line)
        except Exception:
            continue
        t = TIME.ts(d.get("timestamp"))
        if t is None or t < w_from or t >= w_to:      # 창 밖·시각 없는 줄은 세지 않는다
            continue
        typ = d.get("type")
        if typ == "custom_message":
            bell = True                       # 알림이 실린 글 — 원본의 «초인종» 과 같다
            continue
        m = d.get("message") or {}
        role = m.get("role")
        if role == "user":
            head = ""
            for c in m.get("content") or []:
                if isinstance(c, str):
                    head += c
                elif isinstance(c, dict) and c.get("type") == "text":
                    head += c.get("text") or ""
            if BELL_MARK in head[:40]:
                bell = True
                marks["bell"] = True
            continue
        if role == "assistant":
            u = m.get("usage") or {}
            ctx = ctx_of(u)
            if not ctx:                        # usage 0 = API 오류 레코드 — 턴이 아니다
                continue
            if not booted and len(turns) >= BOOT_TAIL:
                booted = True
            was_booted = booted
            calls, reread = [], 0
            for c in m.get("content") or []:
                if not (isinstance(c, dict) and c.get("type") == "toolCall"):
                    continue
                a = c.get("arguments") or {}
                cmd = str(a.get("command") or "")
                calls.append((c.get("name"), cmd))
                if BOOT_MARK in cmd[:CMD_HEAD]:
                    booted = True
                    marks["boot"] = True
                if REREAD_MARK in json.dumps(a, ensure_ascii=False):
                    reread += 1
                    marks["reread"] = True
            turns.append({"ts": t, "ctx": ctx, "u": u, "calls": calls,
                          "bell": bell, "booted": was_booted, "reread": reread})
            bell = False
            continue
        if role == "toolResult":
            raw = res_text(m.get("content")).encode("utf-8")    # 한 벌만 인코딩한다
            results.append({"ts": t, "bytes": len(raw),
                            "cap": cut_notice(raw)})
            continue
    return turns, results, marks


def cut_notice(raw):
    """W4c — 한 결과 글(바이트)이 «잘린 결과» 인가. 셋 다 참일 때만이다.

      ① 줄 전체가 통지 꼴이고 줄 머리부터 맞음(`· <숫자>줄` 은 있어도 없어도 된다)
      ② 그 줄 앞 글의 utf-8 바이트 수(바로 앞 줄바꿈 1개 뺴고) = 통지의 머리 A
      ③ 그 줄 뒤 글의 utf-8 바이트 수(바로 뒤 줄바꿈 1개 뺴고) = 통지의 꼬리 B
    이미 읽은 한 벌 바이트로 판별하고(다시 인코딩 0), 내보내는 것은 예·아니오뿐이다.
    바이트까지 같은 통지 모양을 원문이 인용하면 구분하지 못한다 — 형식 지표다.
    """
    if NOTICE_PREFIX not in raw:          # 통지 글자부터 없으면 바로 끝
        return False
    lines = raw.split(b"\n")
    off = 0
    for i, ln in enumerate(lines):
        if NOTICE_PREFIX in ln:
            m = NOTICE_RX.match(ln)
            if m:
                head_a, tail_b = int(m.group(2)), int(m.group(3))
                before = off - 1 if i else 0                       # 바로 앞 줄바꿈 1개는 뺸다
                after = len(raw) - (off + len(ln) + 1) if i + 1 < len(lines) else 0
                if before == head_a and after == tail_b:
                    return True
        off += len(ln) + 1
    return False


def turn_stats(turns, gate):
    """W1 · W2 · W3 — 한 좌석(또는 한 세션)의 턴 목록에서."""
    if not turns:
        return None
    booted = [t for t in turns if t["booted"]]
    bell = [t for t in booted if t["bell"]]
    w1b = [t for t in bell if t["calls"] and all(pure_recv(nm, cmd) for nm, cmd in t["calls"])]
    denom = sum(cost_of(t["u"]) for t in booted)
    num = sum(cost_of(t["u"]) for t in bell)
    be = next((i for i, t in enumerate(turns) if t["booted"]), None)
    base = be if be is not None else 0
    cross = next((i for i, t in enumerate(turns) if t["ctx"] >= gate), None)
    # 원본 analyze2 의 tail_tok 과 같은 셈 — 넘긴 턴이 없거나 첫 턴이면 값이 없다
    overflow = (turns[-1]["ctx"] - turns[cross - 1]["ctx"]) if cross else None
    return {"turns": len(turns), "booted_turns": len(booted), "bell_turns": len(bell),
            "pure_recv_turns": len(w1b), "bell_cost": num, "booted_cost": denom,
            "share": (num / denom) if denom else 0.0,
            "boot_end_turn": be, "first_ctx": turns[0]["ctx"],
            "boot_end_ctx": turns[base]["ctx"], "boot_calls": sum(len(t["calls"]) for t in turns[:base + 1]),
            "cross_turn": cross, "overflow": overflow, "final_ctx": turns[-1]["ctx"],
            "reread": sum(t["reread"] for t in turns)}


def result_stats(results, cap):
    over = [r for r in results if r["bytes"] > cap]
    return {"results": len(results), "bytes": sum(r["bytes"] for r in results),
            "over": len(over), "over_bytes": sum(r["bytes"] - cap for r in over),
            "cap_marks": sum(1 for r in results if r["cap"])}

# ---------------------------------------------------------------- totals
def totals(sessions):
    """네 숫자 — W1 · W2 는 표식이 있는 세션만, W3 는 잘리지 않은 세션만."""
    use = [s for s in sessions if s["marked"]]
    den = sum(s["booted_cost"] for s in use)
    num = sum(s["bell_cost"] for s in use)
    w1 = {"share": (num / den) if den else 0.0,
          "bell_turns": sum(s["bell_turns"] for s in use),
          "booted_turns": sum(s["booted_turns"] for s in use),
          "pure_recv_turns": sum(s["pure_recv_turns"] for s in use),
          "bell_cost": num, "booted_cost": den, "sessions": len(use)}
    w2v = [s["boot_end_ctx"] - s["first_ctx"] for s in use]
    w2 = {"sessions": len(w2v), "median": med(w2v), "max": max(w2v) if w2v else 0,
          "calls_median": med([s["boot_calls"] for s in use]),
          "calls_max": max([s["boot_calls"] for s in use] or [0])}
    live = [s for s in sessions if not s["truncated"]]
    cross = [s for s in live if s["overflow"] is not None]
    w3 = {"crossed": len(cross), "of": len(live), "median": med([s["overflow"] for s in cross]),
          "max": max([s["overflow"] for s in cross] or [0]),
          "top3": [{"seat": s["seat"], "final_ctx": s["final_ctx"]}
                   for s in sorted(live, key=lambda z: -z["final_ctx"])[:3]]}
    w4 = {"results": sum(s["w4"]["results"] for s in sessions),
          "bytes": sum(s["w4"]["bytes"] for s in sessions),
          "over": sum(s["w4"]["over"] for s in sessions),
          "over_bytes": sum(s["w4"]["over_bytes"] for s in sessions),
          "cap_marks": sum(s["w4"]["cap_marks"] for s in sessions),
          "reread": sum(s["w4"]["reread"] for s in sessions)}
    return {"w1": w1, "w2": w2, "w3": w3, "w4": w4,
            "marked_sessions": len(use), "unmarked_sessions": len(sessions) - len(use)}


def by_seat(sessions):
    out = {}
    for s in sessions:
        if not s["marked"]:
            continue
        g = out.setdefault(s["seat"], {"seat": s["seat"], "role": s["role"], "sessions": 0, "w2": []})
        g["sessions"] += 1
        g["w2"].append(s["boot_end_ctx"] - s["first_ctx"])
    for g in out.values():
        g["w2_median"], g["w2_max"] = med(g["w2"]), max(g["w2"] or [0])
        g.pop("w2")
    return [g for g in out.values()]


def restrict(sessions, lo, hi, gate, cap):
    """--split — 턴을 시각으로 잘라 같은 셈을 다시 한다."""
    out = []
    for s in sessions:
        turns = [t for t in s["turns_raw"] if lo <= (t["ts"] or 0) < hi]
        st = turn_stats(turns, gate)
        if st is None:
            continue
        st["w4"] = result_stats([r for r in s["results_raw"] if lo <= (r["ts"] or 0) < hi], cap)
        st["w4"]["reread"] = st["reread"]
        st.update({"seat": s["seat"], "role": s["role"], "file": s["file"],
                   "truncated": s["truncated"], "marked": s["marked"]})
        out.append(st)
    return out


