# ---------------------------------------------------------------- terminal
def summary(sessions, tot, meta, notes, o, S, L):
    out = []
    hours = "%g시간" % meta["hours"] if L == "ko" else "%gh" % meta["hours"]
    out.append(S["head"] % (hours, len(sessions), TIME.mb(meta["read_bytes"]),
                            time.strftime("%Y-%m-%d %H:%M")))
    for n in notes:
        out.append(n)
    w1, w2, w3, w4 = tot["w1"], tot["w2"], tot["w3"], tot["w4"]
    if tot["marked_sessions"]:
        out.append(S["w1"] % {"share": pct(w1["share"]), "bell": w1["bell_turns"],
                              "boot": w1["booted_turns"], "pure": w1["pure_recv_turns"]})
        out.append(S["w2"] % (k(w2["median"]), k(w2["max"]), w2["calls_median"], w2["sessions"]))
    else:
        out.append(S["no_marks"] % len(sessions))
    if w3["crossed"]:
        top = ", ".join("%s %s" % (x["seat"], k(x["final_ctx"])) for x in w3["top3"])
        out.append(S["w3"] % (k(o.recv_gate), w3["crossed"], k(w3["median"]), k(w3["max"]), top))
    else:
        out.append(S["w3_none"] % k(o.recv_gate))
    ratio = (float(w4["reread"]) / w4["cap_marks"]) if w4["cap_marks"] else 0.0
    out.append(S["w4"] % (w4["results"], by(w4["bytes"]), by(o.result_cap), w4["over"],
                          by(w4["over_bytes"]), w4["cap_marks"], w4["reread"], "%.0f%%" % (100 * ratio)))
    if tot["unmarked_sessions"]:
        out.append(S["no_marks"] % tot["unmarked_sessions"])
    out.append(S["omitted"])
    if meta.get("html"):
        out.append(S["html"] % meta["html"])
    return "\n".join(out)


def summary_split(before, after, meta, o, S, L):
    out = [S["split_head"] % (time.strftime("%m-%d %H:%M", time.localtime(meta["split_from"])),
                             meta["split_label"])]
    rows = [("W1", pct(before["w1"]["share"]), pct(after["w1"]["share"])),
            ("W1b recv only", str(before["w1"]["pure_recv_turns"]), str(after["w1"]["pure_recv_turns"])),
            ("W2", k(before["w2"]["median"]) + "/" + k(before["w2"]["max"]),
             k(after["w2"]["median"]) + "/" + k(after["w2"]["max"])),
            ("W3 max", k(before["w3"]["max"]), k(after["w3"]["max"])),
            ("W4 over", str(before["w4"]["over"]), str(after["w4"]["over"]))]
    for name, b, a in rows:
        out.append(S["split_row"] % (name, b, a))
    return "\n".join(out)


# ---------------------------------------------------------------- html
def render(sessions, tot, meta, S, L, split=None):
    seats = by_seat(sessions)
    w1, w2, w3, w4 = tot["w1"], tot["w2"], tot["w3"], tot["w4"]
    H = ['<!doctype html><meta charset="utf-8"><title>ctx-window</title>', TIME.CSS,
         '<h1>ctx-window — where the conversation window went</h1>',
         '<p>%s · %g%s · 세션 %d개 · 읽기 %s</p>' % (
             html.escape(time.strftime("%Y-%m-%d %H:%M")), meta["hours"],
             "시간" if L == "ko" else "h", len(sessions), TIME.mb(meta["read_bytes"]))]
    for n in meta["notes"]:
        H.append("<p><b>%s</b></p>" % html.escape(n))
    H.append("<h2>1. 네 숫자</h2><table><tr><th>숫자</th><th class=n>값</th><th>뜻</th></tr>")
    H.append("<tr><td>W1 알림 턴 몫</td><td class=n>%s</td><td>부팅 뒤 %d턴 가운데 알림 턴 %d · "
             "recv 만 한 턴 %d (가중 비용 = 읽기 0.1 · 쓰기 1.25 · 입력 1.0)</td></tr>"
             % (pct(w1["share"]), w1["booted_turns"], w1["bell_turns"], w1["pure_recv_turns"]))
    H.append("<tr><td>W2 부팅에 쓴 대화창</td><td class=n>%s / %s</td><td>중앙 / 최대 · 도구 호출 중앙 %d회</td></tr>"
             % (k(w2["median"]), k(w2["max"]), w2["calls_median"]))
    H.append("<tr><td>W3 문턱 뒤 넘침</td><td class=n>%s</td><td>문턱 %s · 넘은 세션 %d · 중앙 %s · 최대 %s</td></tr>"
             % (k(w3["max"]), k(meta["gate"]), w3["crossed"], k(w3["median"]), k(w3["max"])))
    H.append("<tr><td>W4 도구 결과</td><td class=n>%s</td><td>%d건 · %s 초과 %d건(초과분 %s) · 절단 통지 %d · 되읽기 %d</td></tr>"
             % (by(w4["bytes"]), w4["results"], by(meta["cap"]), w4["over"], by(w4["over_bytes"]),
                w4["cap_marks"], w4["reread"]))
    H.append("</table>")
    H.append("<h2>2. %s별</h2><table><tr><th>%s</th><th>역할</th><th class=n>세션</th>"
             "<th class=n>W2 중앙</th><th class=n>W2 최대</th></tr>" % (S["seats"], S["seats"]))
    for g in sorted(seats, key=lambda z: -z["w2_max"]):
        H.append("<tr><td>%s</td><td>%s</td><td class=n>%d</td><td class=n>%s</td><td class=n>%s</td></tr>"
                 % (html.escape(g["seat"]), html.escape(g["role"]), g["sessions"],
                    k(g["w2_median"]), k(g["w2_max"])))
    H.append("</table>")
    H.append("<h2>3. 세션별(끝 대화창 큰 순 24개)</h2><table><tr><th>%s</th><th>역할</th>"
             "<th class=n>턴</th><th class=n>%s</th><th class=n>W2</th><th class=n>끝 대화창</th>"
             "<th class=n>W3 넘침</th><th class=n>W4</th><th>비고</th></tr>"
             % (S["seats"], S["boot_mark"]))
    for s in sorted(sessions, key=lambda z: -z["final_ctx"])[:24]:
        tags = []
        if not s["marked"]:
            tags.append("표식 없음")
        if s["truncated"]:
            tags.append("읽기 잘림")
        H.append("<tr><td>%s</td><td>%s</td><td class=n>%d</td><td class=n>%s</td><td class=n>%s</td>"
                 "<td class=n>%s</td><td class=n>%s</td><td class=n>%s</td><td>%s</td></tr>"
                 % (html.escape(s["seat"]), html.escape(s["role"]), s["turns"],
                    "-" if s["boot_end_turn"] is None else str(s["boot_end_turn"]),
                    k(s["boot_end_ctx"] - s["first_ctx"]) if s["marked"] else "-",
                    k(s["final_ctx"]), "-" if s["overflow"] is None else k(s["overflow"]),
                    by(s["w4"]["bytes"]), html.escape(", ".join(tags) or "-")))
    H.append("</table>")
    if split is not None:
        b, a = split
        head = S["split_head"] % (time.strftime("%m-%d %H:%M", time.localtime(meta["split_from"])),
                                   meta["split_label"])
        H.append("<h2>4. %s</h2><table><tr><th>숫자</th><th class=n>%s</th><th class=n>%s</th></tr>"
                 % (html.escape(head), S["col_before"], S["col_after"]))
        for name, f in (("W1", lambda t: pct(t["w1"]["share"])),
                        ("W1b", lambda t: str(t["w1"]["pure_recv_turns"])),
                        ("W2 중앙", lambda t: k(t["w2"]["median"])),
                        ("W3 최대", lambda t: k(t["w3"]["max"])),
                        ("W4 초과", lambda t: str(t["w4"]["over"]))):
            H.append("<tr><td>%s</td><td class=n>%s</td><td class=n>%s</td></tr>"
                     % (html.escape(name), f(b), f(a)))
        H.append("</table>")
    H.append("<h2>5. 안전 — 읽는 것과 내보내는 것</h2><table><tr><th>읽는다</th><th>어떻게</th>"
             "<th>내보낸다</th></tr>"
             "<tr><td>usage 숫자 · timestamp · type · role · session_info.name</td><td>값 그대로</td>"
             "<td>숫자 · 좌석 이름</td></tr>"
             "<tr><td>도구 결과 글</td><td>utf-8 바이트 수 · W4c 절단 통지 판별(통지 꼴 줄을 글 전체에서 찾고 "
             "그 줄 앞·뒤 바이트 수를 통지의 두 숫자와 견줌)</td><td>숫자만(건수) — 통지 줄의 숫자 · 경로 · 글은 "
             "내보내지 않는다</td></tr>"
             "<tr><td>사용자 글</td><td>머리 40자 안의 <code>[발주 #</code> 유무</td><td>숫자만</td></tr>"
             "<tr><td>도구 호출 인자</td><td><code>command</code> 안의 <code>[부팅 보고]</code> 유무 · "
             "인자 전체 안의 <code>ft-tool-result/</code> 유무</td><td>숫자만</td></tr>"
             "<tr><td>모델 글 · 생각</td><td>읽지 않는다</td><td>—</td></tr></table>"
             "<p>글의 내용은 터미널 · html · json 어디에도 나오지 않는다. 명령 줄 머리도 내보내지 않는다. "
             "고정 표식은 셋(<code>[발주 #</code> · <code>[부팅 보고]</code> · <code>ft-tool-result/</code>)이고 "
             "꼴 판별이 둘(W1c 순수 recv · W4c 절단 통지)이다. 바이트까지 같은 통지 모양을 원문이 인용하면 "
             "W4c 는 구분하지 못한다 — 형식 판별 지표다.</p>")
    return "\n".join(H)


# ---------------------------------------------------------------- main
def main(argv=None):
    ap = argparse.ArgumentParser(prog="ctx-window",
                                 description="Where did the conversation window go? (read-only)")
    ap.add_argument("--seat", default=None, help="seat name pattern (regex)")
    ap.add_argument("--role", default=None, help="master · arch · nano · desk · da")
    ap.add_argument("--hours", type=float, default=3.0, help="window in hours (default 3)")
    ap.add_argument("--max-sessions", type=int, default=40, help="sessions measured (default 40 · 0 = no cap)")
    ap.add_argument("--max-mb", type=float, default=40, help="bytes read in MB (default 40 · 0 = no cap)")
    ap.add_argument("--max-scan", type=int, default=3000, help="files stat'ed (default 3000 · 0 = no cap)")
    ap.add_argument("--recv-gate", type=int, default=280000, help="W3 gate in tokens (default 280000)")
    ap.add_argument("--result-cap", type=int, default=2048, help="W4 result cap in bytes (default 2048)")
    ap.add_argument("--from", dest="w_from", default=None, help="window start (epoch or 'YYYY-MM-DD HH:MM[:SS]')")
    ap.add_argument("--to", dest="w_to", default=None, help="window end")
    ap.add_argument("--split", default=None, help="compare before/after this moment")
    ap.add_argument("--out", default=DEFAULT_OUT, help="html folder (default ~/.cache/ctx-burn/window)")
    ap.add_argument("--no-html", action="store_true", help="write nothing")
    ap.add_argument("--json", action="store_true", help="machine readable (contract ctx-window.v1)")
    ap.add_argument("--lang", choices=["en", "ko"], default="en", help="output language (default en)")
    o = ap.parse_args(argv)
    S, L = STR[o.lang], o.lang

    def moment(x):
        if x is None:
            return None
        try:
            return float(x)
        except ValueError:
            pass
        for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%dT%H:%M:%S"):
            try:
                return datetime.strptime(x, fmt).timestamp()
            except ValueError:
                continue
        raise SystemExit("ctx-window: cannot read the moment %r (use epoch or 'YYYY-MM-DD HH:MM[:SS]')" % x)

    now = time.time()
    w_to = moment(o.w_to) or now
    w_from = moment(o.w_from) or (w_to - o.hours * 3600)
    if w_from >= w_to:
        raise SystemExit("ctx-window: window is empty (--from is not before --to)")
    split = moment(o.split)
    if split is not None and not (w_from < split < w_to):
        print(S["split_out"])
        return 2

    budget = TIME.Budget(o.max_mb)
    files = TIME.list_files(("pi",))              # E5 — pi 만
    keep, scan_cut = TIME.scan_window(files, o.max_scan, w_from, w_to)
    picked, cut = TIME.pick(keep, o, budget)

    notes, sessions, grown = [], [], 0
    if scan_cut:
        notes.append(S["trim_scan"] % (scan_cut, o.max_scan))
    if cut["name"]:
        notes.append(S["trim_name"] % (cut["name"], TIME.mb(budget.limit), TIME.mb(budget.name_limit)))
    if cut["sessions"]:
        notes.append(S["trim_sample"] % (cut["sessions"], o.max_sessions))
    if cut["mb"]:
        notes.append(S["trim_mb"] % (cut["mb"], TIME.mb(budget.limit)))

    for rt, path, nm, role, cap in picked:
        try:
            lines, got, truncated = TIME.read_lines(path, cap)   # E9 — 여는 곳은 이 한 줄뿐
        except OSError:
            continue
        budget.spent += got - cap                                  # 실제로 읽은 바이트로 장부를 맞춘다
        if truncated:
            grown += 1
        turns, results, marks = parse_window_lines(lines, w_from, w_to)
        st = turn_stats(turns, o.recv_gate)
        if st is None:
            continue
        st["w4"] = result_stats(results, o.result_cap)
        st["w4"]["reread"] = st["reread"]
        st.update({"seat": nm, "role": role, "file": path, "truncated": truncated,
                   "marked": any(marks.values()), "turns_raw": turns, "results_raw": results})
        sessions.append(st)

    tot = totals(sessions)
    if grown:                                   # E10 — 잘린 세션은 W3 에서 뺀다
        notes.append(S["trunc"] % grown)

    meta = {"hours": (w_to - w_from) / 3600.0, "from": w_from, "to": w_to, "notes": notes,
            "html": None, "read_bytes": budget.spent, "gate": o.recv_gate, "cap": o.result_cap}
    if split is not None:
        meta["split_from"] = w_from
        meta["split_label"] = time.strftime("%m-%d %H:%M", time.localtime(split))

    if o.json:
        def clean(s):
            return {x: v for x, v in s.items() if x not in ("turns_raw", "results_raw",
                                                            "bell_cost", "booted_cost")}
        out = {"schema": "ctx-window.v1",
               "window": {"from": w_from, "to": w_to, "hours": meta["hours"]},
               "sample": {"files_listed": len(files), "files_scanned": len(keep), "scan_cut": scan_cut,
                          "name_unseen": cut["name"], "sessions_dropped": cut["sessions"],
                          "mb_dropped": cut["mb"], "read_truncated": grown, "read_bytes": budget.spent,
                          "gate": o.recv_gate, "result_cap": o.result_cap},
               "notes": notes, "totals": tot, "sessions": [clean(s) for s in sessions],
               "omitted": ["codex", "claude", "hermes"]}
        if split is not None:
            out["split"] = {"at": split,
                            "before": totals(restrict(sessions, w_from, split, o.recv_gate, o.result_cap)),
                            "after": totals(restrict(sessions, split, w_to, o.recv_gate, o.result_cap))}
        print(json.dumps(out, ensure_ascii=False, indent=1))
        return 0

    if not sessions:
        print(S["head"] % ("%g" % meta["hours"], 0, TIME.mb(0), time.strftime("%Y-%m-%d %H:%M")))
        for n in notes:
            print(n)
        print(S["no_session"])
        print(S["omitted"])
        return 0

    html_path = None
    if not o.no_html:
        out_dir = os.path.expanduser(o.out)
        os.makedirs(out_dir, exist_ok=True)
        html_path = os.path.join(out_dir, "ctx-window.html")
    meta["html"] = html_path
    print(summary(sessions, tot, meta, notes, o, S, L))
    parts = None
    if split is not None:
        parts = (totals(restrict(sessions, w_from, split, o.recv_gate, o.result_cap)),
                 totals(restrict(sessions, split, w_to, o.recv_gate, o.result_cap)))
        print()
        print(summary_split(parts[0], parts[1], meta, o, S, L))
    if html_path:
        with open(html_path, "w", encoding="utf-8") as f:
            f.write(render(sessions, tot, meta, S, L, parts))
    return 0


if __name__ == "__main__":
    sys.exit(main())
